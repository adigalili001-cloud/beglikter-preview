---
// Self-hosted Schibsted Grotesk — registers the family "Schibsted Grotesk", same name as the font/latin token.
import '@fontsource/schibsted-grotesk/400.css';
import '@fontsource/schibsted-grotesk/500.css';
import '@fontsource/schibsted-grotesk/600.css';
import '@fontsource/schibsted-grotesk/700.css';
import '@fontsource/noto-sans-hebrew/400.css';
import '@fontsource/noto-sans-hebrew/700.css';
import '../styles/global.css';
import TopBar from '../components/TopBar.astro';

interface Props {
  title: string;
  current?: string;
  /** true: the page renders its own frame and top bar (Works: the top bar lives inside the pinned stage) */
  bare?: boolean;
  /** Pinterest's own opt-out of its hover buttons (Works: the images move, the buttons chase them) */
  pinterestNoHover?: boolean;
}
const { title, current, bare = false, pinterestNoHover = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline src="/ds/en.js"></script>
    {pinterestNoHover && <meta name="pinterest" content="nohover" />}
    <link rel="stylesheet" href="/ds/fonts.css" />
    <title>{title} — Etamar Beglikter</title>
  </head>
  <body>
    {bare ? <slot /> : (
      <div class="page">
        <TopBar current={current} />
        <slot />
      </div>
    )}
  </body>
</html>
