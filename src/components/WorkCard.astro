---
/**
 * Figma: Design System → Components → Work card (Image slot · Title · Meta).
 * Width is fixed at 300px; the image height comes from the work's `frame`:
 * "original" keeps the photo's proportions, the others crop to a fixed ratio around `focus`.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props { work: CollectionEntry<'works'> }
const { work } = Astro.props;
const d = work.data;

const RATIOS = { landscape: 3 / 2, standard: 4 / 3, portrait: 4 / 5, square: 1 } as const;
const CARD_W = 300;
const ratio = d.frame === 'original' ? d.image.width / d.image.height : RATIOS[d.frame];
const imgH = Math.round(CARD_W / ratio);
const categories = d.categories.map((c) => c.id).join(' ');
---
<article class="work-card" data-categories={categories}>
  <div class="work-image" style={`aspect-ratio: ${CARD_W} / ${imgH}`}>
    <Image
      src={d.image}
      alt={d.alt}
      width={CARD_W}
      height={imgH}
      densities={[1, 2]}
      fit="cover"
      position={d.focus}
      quality={82}
      loading="lazy"
      style={`object-position: ${d.focus}`}
    />
  </div>
  <div class="work-caption">
    <h2 class="t-work-title">{d.title}</h2>
    <p class="t-work-meta">
      {d.year}<br />{d.medium}{d.note && <><br />{d.note}</>}
    </p>
  </div>
</article>

<style>
  .work-card {
    flex: none;
    width: 300px;
    display: flex;
    flex-direction: column;
    gap: var(--card-gap);
  }
  .work-image { width: 100%; overflow: hidden; background: var(--color-gallery-bg-subtle); }
  .work-image :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .work-caption { display: flex; flex-direction: column; gap: var(--card-text-gap); }
  h2, p { margin: 0; }
</style>
