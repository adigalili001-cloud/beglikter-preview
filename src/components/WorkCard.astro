---
/**
 * Figma: Design System → Components → Work card (Image slot · Title · Meta).
 * Width is fixed at 300px; the image height comes from the work's `frame`:
 * "original" keeps the photo's proportions, the others crop to a fixed ratio around `focus`.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { cardImageHeight } from '../lib/supabase-config';

interface Props { work: CollectionEntry<'works'> }
const { work } = Astro.props;
const d = work.data;

const CARD_W = 300;
const imgH = cardImageHeight(d.frame, d.imageWidth ?? null, d.imageHeight ?? null, CARD_W);
const isRemote = d.imageUrl?.startsWith('http');
---
<article class="work-card" data-categories={d.categories.join(' ')}>
  <div class="work-image" style={`aspect-ratio: ${CARD_W} / ${imgH}`}>
    {d.imageUrl && (isRemote ? (
      <Image
        src={d.imageUrl}
        alt={d.alt}
        width={CARD_W}
        height={imgH}
        densities={[1, 2]}
        fit="cover"
        position={d.focus}
        quality={82}
        loading="lazy"
        style={`object-position: ${d.focus}`}
      />
    ) : (
      <img src={d.imageUrl} alt={d.alt} width={CARD_W} height={imgH} loading="lazy" style={`object-position: ${d.focus}`} />
    ))}
  </div>
  <div class="work-caption">
    <h2 class="t-work-title">{d.title}</h2>
    <p class="t-work-meta">
      {d.year}<br />{d.medium}{d.note && <><br />{d.note}</>}
    </p>
  </div>
</article>

<style>
  .work-card {
    flex: none;
    width: 300px;
    display: flex;
    flex-direction: column;
    gap: var(--card-gap);
  }
  .work-image { width: 100%; overflow: hidden; background: var(--color-gallery-bg-subtle); }
  .work-image :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .work-caption { display: flex; flex-direction: column; gap: var(--card-text-gap); }
  h2, p { margin: 0; }
</style>
