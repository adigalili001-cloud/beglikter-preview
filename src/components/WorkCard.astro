---
/**
 * Figma: Design System → Components → Work card (Image slot · Title · Meta).
 * Width is fixed at 300px; the image height comes from the work's `frame`:
 * "original" keeps the photo's proportions, the others crop to a fixed ratio around `focus`.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { cardImageHeight } from '../lib/supabase-config';

interface Props { work: CollectionEntry<'works'> }
const { work } = Astro.props;
const d = work.data;

const CARD_W = 300;
const imgH = cardImageHeight(d.frame, d.imageWidth ?? null, d.imageHeight ?? null, CARD_W);
const isRemote = d.imageUrl?.startsWith('http');
---
<article class="work-card" data-categories={d.categories.join(' ')} data-img-h={imgH}>
  <div class="work-image" style={`aspect-ratio: ${CARD_W} / ${imgH}`}>
    {d.imageUrl && (isRemote ? (
      <Image
        src={d.imageUrl}
        alt={d.alt}
        width={CARD_W}
        height={imgH}
        densities={[1, 2]}
        fit="cover"
        position={d.focus}
        quality={82}
        loading="lazy"
        style={`object-position: ${d.focus}`}
      />
    ) : (
      <!-- data-pin-nohover: these images move with the scroll and grow on hover; Pinterest's hover
           button chases them and flies around. Saving still works from the extension's own button. -->
      <img src={d.imageUrl} alt={d.alt} width={CARD_W} height={imgH} loading="lazy" style={`object-position: ${d.focus}`} data-pin-nohover="true" />
    ))}
  </div>
  <div class="work-caption">
    <h2 class="t-work-title">{d.title}</h2>
    <p class="t-work-meta">
      {d.year}<br />{d.medium}{d.note && <><br />{d.note}</>}
    </p>
    <!-- Hover: a thin arrow under the last meta line, as long as that line (length set by the page script) -->
    <span class="work-arrow" aria-hidden="true">
      <svg class="work-arrow-head" width="7" height="11" viewBox="0 0 7 11" fill="none"><path d="M1 0.6L6 5.5L1 10.4" stroke="currentColor" /></svg>
    </span>
  </div>
</article>

<style>
  .work-card {
    flex: none;
    width: 300px;
    display: flex;
    flex-direction: column;
    gap: var(--card-gap);
  }
  .work-image { position: relative; width: 100%; overflow: hidden; background: var(--color-bg-subtle); }
  /* A clear layer over the image: the pointer meets this layer, not the <img>. Browser extensions that
     put buttons on hovered images (Pinterest and the like) ignore their own opt-outs, and on this page
     the images move, so their buttons fly around. The image stays in the page with its alt text. */
  .work-image::after { content: ''; position: absolute; inset: 0; }
  .work-image :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .work-caption { display: flex; flex-direction: column; gap: var(--card-text-gap); }
  h2, p { margin: 0; }

  .work-card { cursor: pointer; }
  .work-arrow {
    position: relative; display: block; height: 11px; margin-top: var(--space-2);
    width: var(--arrow-w, 0px); color: var(--color-icon-strong);
    clip-path: inset(0 100% 0 0); transition: clip-path .45s cubic-bezier(.2, .7, .2, 1);
  }
  .work-arrow::before {
    content: ''; position: absolute; left: 0; right: 0; top: 50%;
    height: var(--stroke-arrow-long); transform: translateY(-50%); background: currentColor;
  }
  .work-arrow-head { position: absolute; right: 0; top: 0; }
  .work-arrow-head path { stroke-width: var(--stroke-arrow-long); }
  .work-card:hover .work-arrow, .work-card:focus-within .work-arrow { clip-path: inset(0 0 0 0); }
  @media (prefers-reduced-motion: reduce) { .work-arrow { transition: none; } }
</style>
