---
/**
 * Works — version C from the Works lab (artifact "Works · מעבדה", Figma 368:1213).
 *
 * Arrival (Figma frame 1): big title, filters under it, the strip cut off at the fold, so the page
 * invites a scroll down. The first ~160px of scroll settle the layout (frame 2), 1:1 with the hand.
 * From there the page is pinned and the same vertical scroll moves the strip sideways.
 * No scroll handling: one passive listener reads scrollY, every visual is a function of it.
 * Hover: the work grows around its centre and a thin arrow is drawn under its meta.
 * Mobile (< 600px): a plain vertical list; the work crossing the middle of the screen is full size.
 *
 * ?fx=fade|shrink|cascade|none picks the filter transition (default fade) while we compare them.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import FilterChip from '../components/FilterChip.astro';
import WorkCard from '../components/WorkCard.astro';

// Only published works reach the build; their order is set by dragging in the admin
const works = (await getCollection('works')).sort((a, b) => a.data.sortOrder - b.data.sortOrder);

// Only categories that at least one published work uses get a chip, in the order set in the admin
const used = new Set(works.flatMap((w) => w.data.categories));
const categories = (await getCollection('categories'))
  .filter((c) => used.has(c.id))
  .sort((a, b) => a.data.order - b.data.order);
---
<Base title="Works" current="Works" bare>
  <section class="seq-track">
    <div class="seq-stage">
      <TopBar current="Works" />
      <main class="works">
        <div class="header">
          <h1 class="t-page-title"><span class="title-big">Works</span><span class="title-compact" aria-hidden="true">Works</span></h1>
          <div class="filters" role="group" aria-label="Filter works by category">
            <FilterChip label="All" value="" removable={false} />
            {categories.map((c) => <FilterChip label={c.data.label} value={c.id} />)}
          </div>
        </div>
        <section class="gallery-area" aria-label="Works">
          <div class="m-spacer" aria-hidden="true"></div>
          <div class="seq-view">
            {works.map((w) => <WorkCard work={w} />)}
          </div>
        </section>
      </main>
      <div class="seq-counter t-work-meta" aria-hidden="true"></div>
      <!-- Mobile: vertical scroller (Figma 197:49 / 199:323), the desktop scroller turned on its side -->
      <div class="m-scroller" aria-hidden="true">
        <button class="m-start" type="button" tabindex="-1"><svg width="14" height="4" viewBox="0 0 14 4" fill="none"><path d="M0 2H13.4" stroke="currentColor" stroke-width="3" /></svg></button>
        <div class="m-track"><div class="m-thumb"></div></div>
        <button class="m-next" type="button" tabindex="-1"><svg width="16" height="11" viewBox="0 0 16 11" fill="none"><path d="M1.1 1L7.8 8.3L14.5 1" stroke="currentColor" stroke-width="3" /></svg></button>
      </div>
    </div>
  </section>
</Base>

<style>
  .seq-track { position: relative; }             /* height set by the script */
  .seq-stage {
    --margin-x: var(--page-margin-x);
    position: sticky; top: 0;
    height: 100vh; height: 100svh;
    display: flex; flex-direction: column; gap: 68px;              /* ✱ Figma 368:1213 */
    padding: var(--page-margin-y) var(--margin-x);
    overflow: hidden;
  }
  .works { flex: 1; min-height: 0; display: flex; flex-direction: column; gap: 68px; will-change: transform; } /* ✱ */
  h1 { margin: 0; white-space: nowrap; transform-origin: 0 0; will-change: transform; }
  .header { display: flex; flex-direction: column; align-items: flex-start; gap: var(--header-gap); }
  .filters {
    display: flex; flex-wrap: wrap; align-items: center;
    margin-inline: calc(-1 * var(--chip-pad-x)); will-change: transform;
  }
  .gallery-area { flex: 1; min-height: 0; display: flex; flex-direction: column; padding-bottom: var(--space-12); will-change: transform; }
  .seq-view { position: relative; flex: 1; min-height: 0; margin-right: calc(-1 * var(--margin-x)); }
  .seq-view > :global(.work-card) { position: absolute; top: 0; left: 0; will-change: transform; }
  .seq-view > :global(.work-card[hidden]) { display: none; }
  .seq-view :global(.work-image) { transform-origin: 0 0; will-change: transform; }
  .seq-view :global(.work-caption) { will-change: transform; }
  .seq-counter {
    position: absolute; left: var(--margin-x); bottom: var(--space-6); z-index: 2;
    font-variant-numeric: tabular-nums; letter-spacing: .04em; color: var(--color-text-secondary);
  }

  .title-compact, .m-spacer, .m-scroller { display: none; }

  /* Mobile & touch (Figma 197:49 → 199:323): a plain vertical list in normal flow.
     Arrival: big title, filters below. The first ~150px of scroll settle the header into its
     compact, sticky form (title 28 bold, tighter gaps); the list scrolls under it. */
  :global(.is-vertical) .seq-stage { position: static; height: auto; overflow: visible; gap: var(--space-6); }  /* compact: top bar → title 24 */
  :global(.is-vertical) .seq-stage > :global(.top-bar) {
    position: sticky; top: 0; z-index: 6; background: var(--color-bg-page);
    margin-top: calc(-1 * var(--page-margin-y)); padding-top: var(--page-margin-y);
  }
  :global(.is-vertical) .works { gap: var(--space-6); will-change: auto; transform: none !important; }   /* compact: filters → list 24 */
  :global(.is-vertical) .header {
    position: sticky; top: var(--m-header-top, 68px); z-index: 5; background: var(--color-bg-page);
    gap: var(--space-4);                                   /* compact: title → filters 16 */
    margin: calc(-1 * var(--space-6)) 0; padding: var(--space-6) 0;   /* white behind the gaps above and below */
  }
  :global(.is-vertical) h1 { position: relative; height: var(--m-title-h, 26px); transform: none !important; }
  :global(.is-vertical) .title-big { position: absolute; left: 0; top: 0; transform-origin: 0 0; will-change: transform, opacity; }
  :global(.is-vertical) .title-compact {
    display: block; position: absolute; left: 0; top: 0; transform-origin: 0 0; will-change: transform, opacity;
    font-size: var(--type-page-title-compact-size); font-weight: 700; line-height: 0.94; letter-spacing: -0.01em;
  }
  :global(.is-vertical) .filters { margin-inline: 0; }
  :global(.is-vertical) .m-spacer { display: block; height: var(--m-lead, 149px); }
  :global(.is-vertical) .seq-view { margin-right: 0; display: flex; flex-direction: column; gap: var(--space-4); } /* Figma: 16 between works */
  :global(.is-vertical) .seq-view > :global(.work-card) { position: relative; width: 100%; transform: none !important; }
  :global(.is-vertical) .seq-view :global(.work-image) { width: min(300px, 100%); transform: none !important; }
  :global(.is-vertical) .seq-view :global(.work-caption) { transform: none !important; }
  :global(.is-vertical) .seq-counter { display: none; }
  :global(.is-vertical) .seq-view :global(.work-arrow) { display: none; }   /* no hover on touch; Figma: 16 between works */
  :global(.is-vertical) .gallery-area { padding-bottom: var(--page-section-gap); transform: none !important; }
  :global(.is-vertical) .m-scroller {
    display: flex; flex-direction: column; align-items: center; gap: var(--space-4);
    position: fixed; z-index: 4; right: 22px;                      /* ✱ Figma: the line sits 27px from the edge */
    top: var(--m-scroller-top, 192px); bottom: var(--space-4); width: 14px;
    color: var(--color-icon-default);
  }
  .m-scroller button { display: grid; place-items: center; min-width: 24px; min-height: 24px; padding: 0; border: 0; background: none; color: inherit; cursor: pointer; }
  .m-track { position: relative; flex: 1; width: 14px; }
  .m-track::before { content: ''; position: absolute; left: 50%; top: 0; bottom: 0; width: var(--stroke-scroll-track); transform: translateX(-50%); background: var(--color-indicator-track); }
  .m-thumb { position: absolute; left: 50%; top: 0; width: var(--stroke-scroll-thumb); transform: translateX(-50%); background: var(--color-indicator-active); }
</style>

<script>
  type Card = {
    el: HTMLElement; img: HTMLElement; cap: HTMLElement; meta: HTMLElement; arrow: HTMLElement;
    imgH: number; cats: string[]; hv: number; hoverOn: boolean;
  };
  type Item = Card & { src: Card; capH: number; base: number; fit: number; wb: number; xb: number };
  type Pos = { x: number; s: number; w: number };

  const CARD_W = 300;
  const TRAVEL = 1.3;          // px of scroll per px of strip travel (the lab's "fast")
  const HOVER_S = 1.35;        // ✱ hover growth
  const ARRIVAL_GAP = 61;      // ✱ Figma 368:1213: 129 on arrival, 68 settled (top bar→title, filters→strip)
  const FX = new URLSearchParams(location.search).get('fx') || 'fade';
  // Touch screens always get the vertical list: there, scrolling down must never move things sideways
  const TOUCH = matchMedia('(hover: none) and (pointer: coarse)').matches;
  // 18.11 test: a sideways gesture also drives the strip. ?h=off turns it off, to compare.
  const SIDEWAYS = new URLSearchParams(location.search).get('h') !== 'off';
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const root = document.documentElement;
  const track = document.querySelector<HTMLElement>('.seq-track')!;
  const stage = track.querySelector<HTMLElement>('.seq-stage')!;
  const view = stage.querySelector<HTMLElement>('.seq-view')!;
  const worksEl = stage.querySelector<HTMLElement>('.works')!;
  const h1 = stage.querySelector<HTMLElement>('h1')!;
  const filtersEl = stage.querySelector<HTMLElement>('.filters')!;
  const area = stage.querySelector<HTMLElement>('.gallery-area')!;
  const counter = stage.querySelector<HTMLElement>('.seq-counter')!;
  const chips = [...stage.querySelectorAll<HTMLButtonElement>('.chip')];
  const headerEl = stage.querySelector<HTMLElement>('.header')!;
  const titleBig = h1.querySelector<HTMLElement>('.title-big')!;
  const titleCompact = h1.querySelector<HTMLElement>('.title-compact')!;
  const mTrack = stage.querySelector<HTMLElement>('.m-track')!;
  const mThumb = stage.querySelector<HTMLElement>('.m-thumb')!;
  stage.querySelector('.m-start')!.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
  stage.querySelector('.m-next')!.addEventListener('click', () => {
    // next work whose top is below the header
    const hb = headerEl.getBoundingClientRect().bottom + 24;
    const nxt = (G.items as Card[]).find((c) => c.el.getBoundingClientRect().top > hb + 4);
    window.scrollBy({ top: nxt ? nxt.el.getBoundingClientRect().top - hb : innerHeight * 0.8, behavior: reduceMotion ? 'auto' : 'smooth' });
  });

  const cards: Card[] = [...view.querySelectorAll<HTMLElement>('.work-card')].map((el) => ({
    el,
    img: el.querySelector<HTMLElement>('.work-image')!,
    cap: el.querySelector<HTMLElement>('.work-caption')!,
    meta: el.querySelector<HTMLElement>('.t-work-meta')!,
    arrow: el.querySelector<HTMLElement>('.work-arrow')!,
    imgH: parseFloat(el.dataset.imgH || '200'),
    cats: (el.dataset.categories || '').split(' ').filter(Boolean),
    hv: 0, hoverOn: false,
  }));

  const smooth = (x: number) => x * x * (3 - 2 * x);
  const clamp01 = (x: number) => Math.min(1, Math.max(0, x));
  const cssPx = (name: string) => parseFloat(getComputedStyle(root).getPropertyValue(name)) || 0;

  let visible = cards.slice();
  let G: any = null;

  /* ---------- Geometry (on resize / filter) ---------- */
  function measure() {
    const vertical = stage.clientWidth < 600 || TOUCH;
    document.body.classList.toggle('is-vertical', vertical);
    h1.style.height = ''; h1.style.transform = ''; filtersEl.style.transform = '';
    headerEl.style.transform = ''; titleBig.style.transform = ''; titleBig.style.opacity = '';
    titleCompact.style.transform = ''; titleCompact.style.opacity = '';
    area.style.transform = ''; worksEl.style.transform = '';
    if (vertical) {
      track.style.height = '';
      for (const c of cards) { c.el.style.transform = ''; c.img.style.transform = ''; c.cap.style.transform = ''; }
      // Figma 197:49 (arrival) vs 199:323 (settled): extra space on arrival, in px
      const bigH = titleBig.offsetHeight, compactH = titleCompact.offsetHeight;
      const diff = Math.max(0, bigH - compactH);
      const TOP = 24, GAP = 20, LIST = 48;            // ✱ top bar→title 48/24 · title→filters 36/16 · filters→list 72/24
      const LEAD = TOP + diff + GAP + LIST;
      const topBar = stage.querySelector<HTMLElement>('.top-bar');
      const headerTop = topBar?.getBoundingClientRect().height || 44;   // the header's own 24px padding is the gap
      root.style.setProperty('--m-header-top', `${headerTop}px`);
      root.style.setProperty('--m-title-h', `${compactH}px`);
      root.style.setProperty('--m-lead', `${LEAD}px`);
      G = { vertical: true, items: visible, LEAD, diff, TOP, GAP, sc: compactH / (bigH || 1) };
      return;
    }
    const K = cssPx('--type-display-l') / cssPx('--type-page-title-size');     // 120 / 88
    const Hcol = h1.offsetHeight;
    const diff = Hcol * (K - 1);                     // the bigger title pushes the filters down
    const LEAD = ARRIVAL_GAP + diff + ARRIVAL_GAP;   // ≈160px: the strip's way up

    const vh = stage.clientHeight;
    const viewH = view.clientHeight, viewW = view.clientWidth;
    const marginX = parseFloat(getComputedStyle(stage).paddingLeft);
    const gap = cssPx('--gallery-gap') || 12;
    let xb = 0;
    const items: Item[] = visible.map((c) => {
      const capH = c.cap.offsetHeight;
      const fit = (viewH - capH) / c.imgH;
      const base = Math.min(1, fit);                 // very tall works shrink to fit the view
      const wb = CARD_W * base;
      const it = { ...c, src: c, capH, base, fit, wb, xb };
      xb += wb + gap;
      return it;
    });
    const room = viewW - marginX;
    const umax = Math.max(0, xb - gap - room);
    track.style.height = `${umax * TRAVEL + LEAD + vh}px`;
    G = { vertical: false, items, gap, vh, room, umax, LEAD, K, diff };
  }

  /* ---------- Frame ---------- */
  function render() {
    if (!G) return;
    if (G.vertical) return renderVertical();
    const y = window.scrollY - track.offsetTop;

    // Settling: frame 1 → frame 2, 1:1 with the scroll
    const left = 1 - clamp01(y / G.LEAD);
    worksEl.style.transform = `translate3d(0,${(ARRIVAL_GAP * left).toFixed(1)}px,0)`;
    h1.style.transform = `scale(${(1 + (G.K - 1) * left).toFixed(4)})`;
    filtersEl.style.transform = `translate3d(0,${(G.diff * left).toFixed(1)}px,0)`;
    area.style.transform = `translate3d(0,${((G.diff + ARRIVAL_GAP) * left).toFixed(1)}px,0)`;

    // Travel: the strip goes from its left edge to its right edge
    const u = Math.min(G.umax, Math.max(0, (y - G.LEAD) / TRAVEL));
    const pos: Pos[] = G.items.map((it: Item) => ({ x: it.xb - u, s: it.base, w: it.wb }));
    applyHover(pos);
    G.items.forEach((it: Item, i: number) => {
      const p = pos[i];
      it.el.style.transform = `translate3d(${p.x.toFixed(1)}px,0,0)`;
      it.img.style.transform = `scale(${p.s.toFixed(4)})`;
      it.cap.style.transform = `translate3d(0,${(it.imgH * (p.s - 1)).toFixed(1)}px,0)`;
    });
    const q = G.umax > 0 ? u / G.umax : 0;
    const N = G.items.length;
    counter.textContent = N ? `${String(Math.round(q * (N - 1)) + 1).padStart(2, '0')} / ${String(N).padStart(2, '0')}` : '';
  }

  function renderVertical() {
    // Settling: arrival → compact, 1:1 with the scroll (the spacer above the list scrolls away under the header)
    const c = clamp01(window.scrollY / G.LEAD), left = 1 - c;
    headerEl.style.transform = `translate3d(0,${(G.TOP * left).toFixed(1)}px,0)`;
    titleBig.style.transform = `scale(${(1 - (1 - G.sc) * c).toFixed(4)})`;
    titleCompact.style.transform = `scale(${(1 / G.sc + (1 - 1 / G.sc) * c).toFixed(4)})`;
    const x = smooth(clamp01((c - 0.55) / 0.35));               // weight changes near the end: crossfade
    titleBig.style.opacity = String(1 - x);
    titleCompact.style.opacity = String(x);
    filtersEl.style.transform = `translate3d(0,${((G.diff + G.GAP) * left).toFixed(1)}px,0)`;
    // vertical scroller: starts at the list, runs to the bottom
    const headerBottom = headerEl.getBoundingClientRect().bottom;
    const listTop = view.getBoundingClientRect().top;
    root.style.setProperty('--m-scroller-top', `${Math.max(headerBottom + 24, listTop).toFixed(0)}px`);
    const max = document.documentElement.scrollHeight - innerHeight;
    const trackH = mTrack.clientHeight;
    const thumbH = Math.max(24, trackH * innerHeight / document.documentElement.scrollHeight);
    const q = max > 0 ? window.scrollY / max : 0;
    mThumb.style.height = `${thumbH.toFixed(0)}px`;
    mThumb.style.transform = `translate(-50%,${((trackH - thumbH) * q).toFixed(1)}px)`;
  }

  let raf = 0;
  const schedule = () => { if (!raf) raf = requestAnimationFrame(() => { raf = 0; render(); }); };
  window.addEventListener('scroll', schedule, { passive: true });
  new ResizeObserver(() => { measure(); render(); }).observe(stage);

  /* ---------- Hover: grow around the centre, away from the strip's ends ---------- */
  function applyHover(pos: Pos[]) {
    G.items.forEach((it: Item, i: number) => {
      const h = smooth(clamp01(it.src.hv));
      if (h < 0.001) return;
      const p = pos[i];
      const target = Math.min(p.s * HOVER_S, it.fit, G.room / CARD_W);
      const newS = p.s + (Math.max(p.s, target) - p.s) * h;
      const extra = CARD_W * (newS - p.s);
      const first = pos[0], last = pos[pos.length - 1];
      const wl = clamp01(-first.x / 150), wr = clamp01((last.x + last.w - G.room) / 150);
      const shiftL = wl + wr > 0 ? extra * wl / (wl + wr) : 0;
      const shiftR = extra - shiftL;
      pos.forEach((o, j) => { if (j < i) o.x -= shiftL; else if (j > i) o.x += shiftR; });
      p.x -= shiftL; p.s = newS; p.w = CARD_W * newS;
    });
  }
  let hoverRaf = 0;
  function tickHover() {
    hoverRaf = 0;
    let moving = false;
    for (const c of cards) {
      const t = c.hoverOn ? 1 : 0;
      if (Math.abs(t - c.hv) > 0.002) { c.hv += (t - c.hv) * 0.16; moving = true; } else c.hv = t;
    }
    render();
    if (moving) hoverRaf = requestAnimationFrame(tickHover);
  }
  for (const c of cards) {
    c.el.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse') return;
      c.hoverOn = true; if (reduceMotion) c.hv = 1;
      // arrow length = width of the last meta line
      const r = document.createRange(); r.selectNodeContents(c.meta);
      const rects = [...r.getClientRects()].filter((x) => x.width > 0);
      const lastLine = rects[rects.length - 1];
      if (lastLine) c.arrow.style.setProperty('--arrow-w', `${Math.round(lastLine.width)}px`);
      if (!hoverRaf && !G?.vertical) hoverRaf = requestAnimationFrame(tickHover);
    });
    c.el.addEventListener('pointerleave', () => {
      c.hoverOn = false; if (reduceMotion) c.hv = 0;
      if (!hoverRaf && !G?.vertical) hoverRaf = requestAnimationFrame(tickHover);
    });
  }

  /* ---------- Filtering: several categories can be on; a work shows if it has ANY of them ----------
     The page stays where it is. Only if the strip had travelled, it returns to its start. */
  const selected = new Set((new URLSearchParams(location.search).get('filter') ?? '').split(',').filter(Boolean));
  let anims: Animation[] = [];

  function applyFilter(instant = false) {
    for (const chip of chips) {
      const v = chip.dataset.filter!;
      chip.setAttribute('aria-pressed', String(v === '' ? selected.size === 0 : selected.has(v)));
    }
    const url = new URL(location.href);
    if (selected.size) url.searchParams.set('filter', [...selected].join(','));
    else url.searchParams.delete('filter');
    history.replaceState(null, '', url);

    const prev = visible;
    const next = cards.filter((c) => selected.size === 0 || c.cats.some((k) => selected.has(k)));
    const mode = instant ? 'none' : FX;
    for (const a of anims) a.cancel();
    anims = [];
    for (const c of cards) c.el.style.zIndex = '';

    const before = new Map(prev.map((c) => [c, c.el.getBoundingClientRect().left]));
    const exiting = prev.filter((c) => !next.includes(c));
    const entering = next.filter((c) => !prev.includes(c));
    const narrowing = next.length < prev.length;

    visible = next;
    for (const c of cards) c.el.hidden = !next.includes(c) && !(mode !== 'none' && exiting.includes(c));
    measure();
    if (!G.vertical) {
      const settled = track.offsetTop + G.LEAD;
      if (window.scrollY > settled) window.scrollTo({ top: settled, behavior: 'instant' as ScrollBehavior });
    }
    render();
    if (mode === 'none' || reduceMotion || G.vertical) { for (const c of exiting) c.el.hidden = true; return; }

    const onScreen = (c: Card) => { const r = c.el.getBoundingClientRect(); return r.right > -50 && r.left < innerWidth + 50; };
    const add = (el: HTMLElement, kf: Keyframe[], o: KeyframeAnimationOptions) => {
      const a = el.animate(kf, { fill: 'backwards', composite: 'add', ...o }); anims.push(a); return a;
    };
    const hideAfter = (a: Animation, c: Card) => { const h = () => { if (!visible.includes(c)) c.el.hidden = true; }; a.finished.then(h, h); };
    const ease = 'cubic-bezier(.2,.7,.2,1)';
    const slideStaying = (delay: number, duration: number) => {
      for (const c of next) if (before.has(c)) {
        const dx = before.get(c)! - c.el.getBoundingClientRect().left;
        if (Math.abs(dx) > 0.5) add(c.el, [{ transform: `translateX(${dx}px)` }, { transform: 'translateX(0)' }], { duration, delay, easing: ease });
      }
    };
    const byLeft = (a: Card, b: Card) => a.el.getBoundingClientRect().left - b.el.getBoundingClientRect().left;

    if (mode === 'fade') {
      for (const c of exiting) { c.el.style.zIndex = '0'; hideAfter(add(c.el, [{ opacity: 0 }], { duration: 180, easing: 'linear', fill: 'forwards', composite: 'replace' }), c); }
      slideStaying(120, 520);
      for (const c of entering) add(c.el, [{ opacity: 0 }, { opacity: 1 }], { duration: 360, delay: 300, easing: 'linear', composite: 'replace' });
    }
    if (mode === 'shrink') {
      for (const c of exiting) hideAfter(add(c.el, [{ opacity: 1, transform: 'scale(1)' }, { opacity: 0, transform: 'scale(.82)' }], { duration: 260, easing: ease, fill: 'forwards' }), c);
      slideStaying(narrowing ? 140 : 0, 560);
      entering.filter(onScreen).sort(byLeft).forEach((c, i) =>
        add(c.el, [{ opacity: 0, transform: 'scale(.86)' }, { opacity: 1, transform: 'scale(1)' }], { duration: 480, delay: 220 + i * 45, easing: ease }));
    }
    if (mode === 'cascade') {
      const out = narrowing ? 24 : -24, inn = narrowing ? 28 : -28;
      const old = prev.filter(onScreen).sort((a, b) => before.get(a)! - before.get(b)!);
      old.forEach((c, i) => {
        const a = add(c.el, [{ transform: 'translateY(0)', opacity: 1 }, { transform: `translateY(${out}px)`, opacity: 0 }],
          { duration: 220, delay: i * 30, easing: 'cubic-bezier(.4,0,.8,.4)', fill: 'forwards' });
        if (exiting.includes(c)) hideAfter(a, c);
      });
      const outEnd = old.length * 30 + 220;
      next.filter(onScreen).sort(byLeft).forEach((c, i) =>
        add(c.el, [{ transform: `translateY(${inn}px)`, opacity: 0 }, { transform: 'translateY(0)', opacity: 1 }],
          { duration: 520, delay: outEnd * 0.6 + i * 50, easing: ease }));
      for (const c of exiting.filter((c) => !onScreen(c))) c.el.hidden = true;
    }
    // when it is over, remove every animation so nothing keeps a stale opacity or offset
    const mine = anims;
    Promise.allSettled(mine.map((a) => a.finished)).then(() => {
      if (anims !== mine) return;
      for (const c of cards) { c.el.style.zIndex = ''; if (!visible.includes(c)) c.el.hidden = true; }
      for (const a of mine) a.cancel();
      anims = [];
    });
  }

  for (const chip of chips) {
    chip.addEventListener('click', () => {
      const v = chip.dataset.filter!;
      if (v === '') selected.clear();
      else if (selected.has(v)) selected.delete(v);
      else selected.add(v);
      applyFilter();
    });
  }

  applyFilter(true);
  document.fonts?.ready.then(() => { measure(); render(); });

  /* ---------- Sideways gestures (test, 18.11) ----------
     A sideways trackpad swipe (or Shift + wheel) becomes the same page scroll, so both directions
     move one position: header, strip and counter stay in sync. Nothing is stopped or snapped:
     each px of the hand sideways is TRAVEL px of scroll, i.e. the strip follows the fingers 1:1,
     and the trackpad's own momentum carries on. Vertical scrolling is never touched.
     Each gesture keeps the axis it started with (events < 160ms apart are one gesture),
     so a slightly diagonal swipe doesn't do two things at once. */
  if (SIDEWAYS && !TOUCH) {
    root.style.overscrollBehaviorX = 'none';          // a sideways swipe must not go "back" a page
    document.body.style.overscrollBehaviorX = 'none';
    let axis: 'x' | 'y' | null = null, lastT = 0;
    window.addEventListener('wheel', (e) => {
      if (!G || G.vertical || e.ctrlKey) return;      // ctrl = pinch-zoom
      const now = performance.now();
      if (now - lastT > 160) axis = null;
      lastT = now;
      if (!axis) axis = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? 'x' : 'y';
      if (axis !== 'x') return;
      e.preventDefault();
      const unit = e.deltaMode === 1 ? 16 : e.deltaMode === 2 ? innerHeight : 1;
      window.scrollBy(0, e.deltaX * unit * TRAVEL);
    }, { passive: false });

    // keyboard: ← → move one work
    window.addEventListener('keydown', (e) => {
      if (!G || G.vertical || e.altKey || e.metaKey || e.ctrlKey) return;
      const t = e.target as HTMLElement;
      if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
      const dir = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!dir) return;
      e.preventDefault();
      window.scrollBy({ top: dir * (CARD_W + G.gap) * TRAVEL, behavior: reduceMotion ? 'auto' : 'smooth' });
    });
  }
</script>
